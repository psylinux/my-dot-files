[user]
	name = Marcos Azevedo (psylinux)
	email = psylinux@gmail.com
[push]
	default = simple
[pull]
	rebase = false
[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[init]
	defaultBranch = master
# Machine-local settings (e.g. safe.directory for engagement paths) live in this untracked file.
[include]
	path = ~/.gitconfig.local
