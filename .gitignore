# Ignore rules for this repo only. The machine-wide list lives in
# stow/common/.config/git/ignore (stowed to ~/.config/git/ignore).

# OS / editor noise, repeated so clones without the global list stay clean.
.DS_Store
*.swp
*.swo

# This repo is public. Stow runs with --no-folding so apps never write into
# stow/, but if a directory ever gets folded again, keep keys and runtime
# data out of git. Only the tracked config files are allowed.
stow/*/.ssh/*
!stow/*/.ssh/config
stow/*/.gnupg/*
!stow/*/.gnupg/gpg-agent.conf
!stow/*/.gnupg/sshcontrol
stow/linux/.irssi/*
!stow/linux/.irssi/config
!stow/linux/.irssi/default.theme
!stow/linux/.irssi/scripts/
